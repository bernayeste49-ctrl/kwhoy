---
import { fmtPrice } from '../lib/prices.js';
interface Props { day: any }
const { day } = Astro.props;
const half = Math.ceil(day.hours.length / 2);
const parts = [day.hours.slice(0, half), day.hours.slice(half)];
const nivel = { barata: 'Barata', media: 'Media', cara: 'Cara' };
---
<div class="pt">
  {parts.map((rows) => (
    <table>
      <thead><tr><th>Hora</th><th class="num">€/kWh</th><th>Nivel</th><th>Periodo</th></tr></thead>
      <tbody>
        {rows.map((h) => (
          <tr data-hour={h.hour}>
            <td>{h.label}</td>
            <td class="num">{fmtPrice(h.price)}</td>
            <td><span class={`pill ${h.nivel}`}>{nivel[h.nivel]}</span></td>
            <td>{h.periodo.charAt(0).toUpperCase() + h.periodo.slice(1)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ))}
</div>
<style>
  .pt { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; align-items: start; }
  @media (max-width: 860px) { .pt { grid-template-columns: 1fr; } .pt table:last-child thead { display: none; } }
</style>
