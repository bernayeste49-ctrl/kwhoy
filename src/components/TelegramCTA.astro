---
// Invitación al canal de Telegram con el precio de mañana
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<aside class:list={['tg', { compact }]} aria-label="Canal de Telegram">
  <svg class="tg-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21.5 3.6 2.9 10.8c-1.3.5-1.2 1.3-.2 1.6l4.8 1.5 1.8 5.6c.2.6.4.8.9.8.4 0 .6-.2.9-.5l2.3-2.2 4.7 3.5c.9.5 1.5.2 1.7-.8l3.1-14.6c.3-1.3-.5-1.8-1.4-1.1ZM9.3 14.2l8.6-5.4c.4-.3.8-.1.5.2l-7 6.4-.3 3-1.8-4.2Z"/></svg>
  <div class="tg-text">
    <p class="tg-title">Recibe el precio de mañana cada tarde en Telegram</p>
    {!compact && <p class="tg-sub">Un mensaje al día con las horas más baratas y más caras. Gratis, y puedes salir cuando quieras.</p>}
  </div>
  <a class="tg-btn" href="https://t.me/kwhoy" target="_blank" rel="noopener">Unirme al canal</a>
</aside>
<style>
  .tg { display: flex; align-items: center; gap: 16px; background: var(--night); color: #fff; border-radius: 16px; padding: 18px 22px; margin: 0 0 32px; }
  .tg-icon { width: 36px; height: 36px; flex: none; fill: var(--spark); }
  .tg-text { flex: 1; min-width: 0; }
  .tg-title { margin: 0; font-weight: 700; font-size: 1.05rem; }
  .tg-sub { margin: 4px 0 0; color: #b9cbc5; font-size: 0.92rem; }
  .tg-btn { flex: none; background: var(--spark); color: var(--night); font-weight: 700; padding: 10px 18px; border-radius: 999px; text-decoration: none; }
  .tg-btn:hover { filter: brightness(1.05); }
  .tg-btn:focus-visible { outline: 3px solid #fff; outline-offset: 2px; }
  .tg.compact { padding: 14px 18px; }
  @media (max-width: 640px) {
    .tg { flex-wrap: wrap; }
    .tg-text { flex-basis: calc(100% - 52px); }
    .tg-btn { width: 100%; text-align: center; }
  }
</style>
