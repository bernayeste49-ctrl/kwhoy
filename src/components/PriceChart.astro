---
import { fmtPrice } from '../lib/prices.js';
interface Props { day: any }
const { day } = Astro.props;
const W = 760, H = 260, left = 44, right = 8, top = 16, bottom = 34;
const n = day.hours.length;
const maxP = Math.max(0.05, ...day.hours.map((h) => h.price));
const minP = Math.min(0, ...day.hours.map((h) => h.price));
const span = maxP - minP;
const y = (v) => top + (maxP - v) / span * (H - top - bottom);
const band = (W - left - right) / n;
const ticks = [0, maxP / 2, maxP].map((t) => Math.round(t * 100) / 100);
const color = { barata: 'var(--barata)', media: 'var(--media)', cara: 'var(--cara)' };
---
<figure class="chart card">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Precio de la luz por horas: mínimo ${fmtPrice(day.min)} y máximo ${fmtPrice(day.max)} €/kWh`}>
    {ticks.map((t) => (
      <g>
        <line x1={left} x2={W - right} y1={y(t)} y2={y(t)} stroke="#e2e8f0" />
        <text x={left - 6} y={y(t) + 4} text-anchor="end" font-size="11" fill="#64748b">{t.toLocaleString('es-ES', { minimumFractionDigits: 2 })}</text>
      </g>
    ))}
    {day.hours.map((h, i) => {
      const y0 = y(0), yv = y(h.price);
      return (
        <rect data-hour={h.hour} x={left + i * band + 2} y={Math.min(y0, yv)} width={band - 4} height={Math.max(1, Math.abs(y0 - yv))} rx="3" fill={color[h.nivel]}>
          <title>{`${h.label}: ${fmtPrice(h.price)} €/kWh`}</title>
        </rect>
      );
    })}
    {day.hours.map((h, i) => i % 2 === 0 && (
      <text x={left + i * band + band / 2} y={H - 14} text-anchor="middle" font-size="11" fill="#64748b">{String(h.hour).padStart(2, '0')}h</text>
    ))}
    <text x={left} y={H - 1} font-size="10" fill="#64748b">€/kWh · verde: horas más baratas · rojo: más caras</text>
  </svg>
</figure>
<style>
  .chart { margin: 16px 0; padding: 12px; }
  svg { width: 100%; height: auto; display: block; }
  rect.now { stroke: #0f172a; stroke-width: 2; }
</style>
