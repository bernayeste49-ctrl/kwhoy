---
import PriceChart from './PriceChart.astro';
import PriceTable from './PriceTable.astro';
import { fmtPrice, bestWindow, vsPrevious } from '../lib/prices.js';
interface Props { day: any; live?: boolean }
const { day, live = false } = Astro.props;
const w2 = bestWindow(day, 2);
const w3 = bestWindow(day, 3);
const diff = vsPrevious(day);
const hh = (x) => String(x.hour).padStart(2, '0') + ':00';
const endh = (x) => String((x.hour + 1) % 24).padStart(2, '0') + ':00';
---
<div class="day-view" data-iso={day.iso} data-live={live ? '1' : ''} data-prices={JSON.stringify(day.hours.map((h) => [h.hour, h.price]))}>
  <div class="grid-stats">
    {live && (
      <div class="stat now" id="now-box">
        <div class="k">Precio ahora</div>
        <div class="v" id="now-price">—</div>
        <div class="s" id="now-label">€/kWh</div>
      </div>
    )}
    <div class="stat barata">
      <div class="k">Hora más barata</div>
      <div class="v">{fmtPrice(day.min)}</div>
      <div class="s">{day.cheapest.label} · €/kWh</div>
    </div>
    <div class="stat cara">
      <div class="k">Hora más cara</div>
      <div class="v">{fmtPrice(day.max)}</div>
      <div class="s">{day.priciest.label} · €/kWh</div>
    </div>
    <div class="stat">
      <div class="k">Precio medio del día</div>
      <div class="v">{fmtPrice(day.avg)}</div>
      <div class="s">{diff === null ? '€/kWh' : `${diff > 0 ? '+' : ''}${diff.toLocaleString('es-ES', { maximumFractionDigits: 1 })} % vs. día anterior`}</div>
    </div>
  </div>

  <p>
    <strong>Mejores horas para consumir:</strong> {day.cheap3.map((h) => h.label).join(', ')}.
    Si vas a poner la lavadora o el lavavajillas (unas 2 horas), lo más barato es de <strong>{hh(w2.start)} a {endh(w2.end)}</strong>{' '}
    ({fmtPrice(w2.avg)} €/kWh de media). Para 3 horas seguidas: de {hh(w3.start)} a {endh(w3.end)}.
  </p>
  {day.findeOFestivo && <p class="muted">Hoy es fin de semana o festivo nacional: con la tarifa 2.0TD todas las horas son periodo valle para los peajes.</p>}

  <PriceChart day={day} />
  <PriceTable day={day} />
  <p class="muted">Precio del PVPC (tarifa regulada 2.0TD) publicado por Red Eléctrica, en €/kWh, sin IVA ni impuesto eléctrico. Si tienes una tarifa de mercado libre con precio fijo, tu precio no cambia por horas.</p>
</div>

<script>
  // Resalta la hora actual (hora peninsular) y muestra el "precio ahora".
  const el = document.querySelector('.day-view[data-live="1"]') as HTMLElement | null;
  if (el) {
    const fmt = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Madrid', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', hour12: false });
    const parts = Object.fromEntries(fmt.formatToParts(new Date()).map((p) => [p.type, p.value]));
    const today = `${parts.year}-${parts.month}-${parts.day}`;
    const hour = Number(parts.hour) % 24;
    const prices: [number, number][] = JSON.parse(el.dataset.prices || '[]');
    if (today === el.dataset.iso) {
      const p = prices.find(([h]) => h === hour);
      if (p) {
        document.getElementById('now-price')!.textContent = p[1].toLocaleString('es-ES', { minimumFractionDigits: 4, maximumFractionDigits: 4 });
        document.getElementById('now-label')!.textContent = `€/kWh · de ${String(hour).padStart(2, '0')}:00 a ${String((hour + 1) % 24).padStart(2, '0')}:00`;
      }
      document.querySelectorAll(`tr[data-hour="${hour}"]`).forEach((r) => r.classList.add('current'));
      document.querySelectorAll(`rect[data-hour="${hour}"]`).forEach((r) => r.classList.add('now'));
    } else {
      document.getElementById('now-box')?.remove();
    }
  }
</script>
