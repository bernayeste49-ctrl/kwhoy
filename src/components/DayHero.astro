---
import Dial from './Dial.astro';
import { fmtPrice, vsPrevious } from '../lib/prices.js';
interface Props { day: any; live?: boolean; kicker: string; title: string; note?: string }
const { day, live = false, kicker, title, note } = Astro.props;
const diff = vsPrevious(day);
---
<section class="hero" data-iso={day.iso} data-live={live ? '1' : ''} data-prices={JSON.stringify(day.hours.map((h) => [h.hour, h.price, h.nivel]))}>
  <div class="wrap grid">
    <div class="text">
      <p class="kicker">{kicker}</p>
      <h1>{title}</h1>
      {live && (
        <div class="now" id="now" hidden>
          <p class="now-state">La luz ahora está <strong id="now-level">—</strong></p>
          <p class="now-price"><span id="now-price">—</span><span class="unit">€/kWh</span></p>
          <p class="now-next" id="now-next"></p>
        </div>
      )}
      <dl class="facts">
        <div><dt>Más barata</dt><dd class="v barata">{fmtPrice(day.min)}</dd><dd>{day.cheapest.label}</dd></div>
        <div><dt>Más cara</dt><dd class="v cara">{fmtPrice(day.max)}</dd><dd>{day.priciest.label}</dd></div>
        <div><dt>Media</dt><dd class="v">{fmtPrice(day.avg)}</dd><dd>{diff === null ? '€/kWh' : `${diff > 0 ? '+' : '−'}${Math.abs(diff).toLocaleString('es-ES', { maximumFractionDigits: 1 })} % vs. día anterior`}</dd></div>
      </dl>
      {note && <p class="note">{note}</p>}
    </div>
    <Dial day={day} live={live} />
  </div>
</section>

<script>
  const el = document.querySelector('.hero[data-live="1"]') as HTMLElement | null;
  if (el) {
    const fmt = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Madrid', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', hour12: false });
    const p = Object.fromEntries(fmt.formatToParts(new Date()).map((x) => [x.type, x.value]));
    const today = `${p.year}-${p.month}-${p.day}`;
    const hour = Number(p.hour) % 24;
    const prices: [number, number, string][] = JSON.parse(el.dataset.prices || '[]');
    const now = prices.find(([h]) => h === hour);
    if (today === el.dataset.iso && now) {
      const nivel: Record<string, string> = { barata: 'barata', media: 'a precio medio', cara: 'cara' };
      const f4 = (v: number) => v.toLocaleString('es-ES', { minimumFractionDigits: 4, maximumFractionDigits: 4 });
      const hh = (h: number) => String(h % 24).padStart(2, '0') + ':00';
      const box = document.getElementById('now')!;
      box.hidden = false;
      box.classList.add(now[2]);
      document.getElementById('now-level')!.textContent = nivel[now[2]];
      document.getElementById('now-price')!.textContent = f4(now[1]);
      let msg = `De ${hh(hour)} a ${hh(hour + 1)}. `;
      const run = (start: number) => { let e = start; while (prices.find(([h, , n]) => h === e + 1 && n === 'barata')) e++; return e; };
      if (now[2] === 'barata') msg += `Seguirá barata hasta las ${hh(run(hour) + 1)}.`;
      else {
        const next = prices.find(([h, , n]) => h > hour && n === 'barata');
        msg += next ? `Próxima franja barata: de ${hh(next[0])} a ${hh(run(next[0]) + 1)}.` : 'Hoy ya no quedan horas baratas: mira el precio de mañana.';
      }
      document.getElementById('now-next')!.textContent = msg;
      document.getElementById('dial-k')!.textContent = `Ahora · ${hh(hour)}`;
      document.getElementById('dial-v')!.textContent = f4(now[1]);
      document.querySelectorAll<SVGPathElement>('.seg').forEach((s) => {
        const h = Number(s.dataset.hour);
        if (h < hour) s.classList.add('past');
        if (h === hour) s.classList.add('now');
      });
      const needle = document.getElementById('needle') as unknown as SVGLineElement | null;
      if (needle) { needle.style.display = ''; needle.setAttribute('transform', `rotate(${((hour + 0.5) / 24) * 360} 260 260)`); }
      document.querySelectorAll(`.bar[data-hour="${hour}"]`).forEach((b) => b.classList.add('now'));
      document.querySelectorAll(`tr[data-hour="${hour}"]`).forEach((r) => r.classList.add('current'));
    }
  }
</script>

<style>
  .hero { background: radial-gradient(900px 520px at 78% 45%, #17382f 0%, transparent 70%), var(--night); color: #eaf3f0; padding: 28px 0 56px; }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 500px); gap: 48px; align-items: center; }
  .kicker { margin: 0 0 8px; color: #8fa9a3; font-weight: 600; }
  h1 { margin: 0; color: #fff; font-size: clamp(2.1rem, 4.6vw, 3.4rem); }
  .now { margin-top: 26px; }
  .now p { margin: 0; }
  .now-state { font-size: 1.15rem; color: #d5e3df; }
  .now-state strong { font-weight: 750; }
  .now.barata strong { color: var(--n-barata); }
  .now.media strong { color: var(--n-media); }
  .now.cara strong { color: var(--n-cara); }
  .now-price { display: flex; align-items: baseline; gap: 14px; font-size: clamp(3.4rem, 10vw, 6rem); font-weight: 850; font-stretch: 125%; letter-spacing: -0.05em; line-height: 1; margin: 8px 0 14px !important; color: #fff; }
  .now-price .unit { font-size: 1.15rem; font-weight: 600; letter-spacing: 0; color: #8fa9a3; }
  .now-next { display: inline-block; background: #143a31; border: 1px solid #22524a; color: #eaf3f0; padding: 12px 16px; border-radius: 14px; max-width: 48ch; }
  .facts { display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: 8px 36px; margin: 34px 0 0; }
  .facts div { display: grid; }
  .facts dt { color: #8fa9a3; font-size: 0.9rem; }
  .facts dd { margin: 0; color: #8fa9a3; font-size: 0.85rem; }
  .facts dd.v { color: #fff; font-size: 1.6rem; font-weight: 800; font-stretch: 118%; letter-spacing: -0.02em; line-height: 1.25; }
  .facts dd.v.barata { color: var(--n-barata); }
  .facts dd.v.cara { color: var(--n-cara); }
  .note { margin: 24px 0 0; color: #8fa9a3; font-size: 0.92rem; max-width: 56ch; }
  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; gap: 28px; }
    .hero { padding-top: 18px; }
    .facts { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px 16px; }
    .facts dd.v { font-size: 1.2rem; }
  }
</style>
