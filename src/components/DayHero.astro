---
import Ribbon from './Ribbon.astro';
import { fmtPrice, vsPrevious } from '../lib/prices.js';
interface Props { day: any; live?: boolean; kicker: string; title: string; note?: string }
const { day, live = false, kicker, title, note } = Astro.props;
const diff = vsPrevious(day);
const nivelTxt = { barata: 'barata', media: 'a precio medio', cara: 'cara' };
---
<section class="hero" data-iso={day.iso} data-live={live ? '1' : ''} data-prices={JSON.stringify(day.hours.map((h) => [h.hour, h.price, h.nivel]))}>
  <div class="wrap">
    <div class="top">
      <div class="head">
        <p class="kicker">{kicker}</p>
        <h1>{title}</h1>
        {live ? (
          <div class="now" id="now" hidden>
            <p class="now-state">La luz ahora está <strong id="now-level">—</strong></p>
            <p class="now-price"><span id="now-price">—</span> <span class="unit">€/kWh</span></p>
            <p class="now-next" id="now-next"></p>
          </div>
        ) : null}
        {note && <p class="note">{note}</p>}
      </div>
      <dl class="facts">
        <div class="fact barata"><dt>Hora más barata</dt><dd><b>{fmtPrice(day.min)}</b> €/kWh</dd><dd class="sub">{day.cheapest.label}</dd></div>
        <div class="fact cara"><dt>Hora más cara</dt><dd><b>{fmtPrice(day.max)}</b> €/kWh</dd><dd class="sub">{day.priciest.label}</dd></div>
        <div class="fact"><dt>Media del día</dt><dd><b>{fmtPrice(day.avg)}</b> €/kWh</dd><dd class="sub">{diff === null ? 'sin datos del día anterior' : `${diff > 0 ? '+' : '−'}${Math.abs(diff).toLocaleString('es-ES', { maximumFractionDigits: 1 })} % que el día anterior`}</dd></div>
      </dl>
    </div>
    <Ribbon day={day} />
  </div>
</section>

<script>
  const el = document.querySelector('.hero[data-live="1"]') as HTMLElement | null;
  if (el) {
    const fmt = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Madrid', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', hour12: false });
    const p = Object.fromEntries(fmt.formatToParts(new Date()).map((x) => [x.type, x.value]));
    const today = `${p.year}-${p.month}-${p.day}`;
    const hour = Number(p.hour) % 24;
    const prices: [number, number, string][] = JSON.parse(el.dataset.prices || '[]');
    const now = prices.find(([h]) => h === hour);
    if (today === el.dataset.iso && now) {
      const nivel: Record<string, string> = { barata: 'barata', media: 'a precio medio', cara: 'cara' };
      const box = document.getElementById('now')!;
      box.hidden = false;
      box.classList.add(now[2]);
      document.getElementById('now-level')!.textContent = nivel[now[2]];
      document.getElementById('now-price')!.textContent = now[1].toLocaleString('es-ES', { minimumFractionDigits: 4, maximumFractionDigits: 4 });
      const hh = (h: number) => String(h % 24).padStart(2, '0') + ':00';
      let msg = `De ${hh(hour)} a ${hh(hour + 1)}.`;
      if (now[2] !== 'barata') {
        const next = prices.find(([h, , n]) => h > hour && n === 'barata');
        if (next) {
          let end = next[0];
          while (prices.find(([h, , n]) => h === end + 1 && n === 'barata')) end++;
          msg += ` Próxima franja barata: de ${hh(next[0])} a ${hh(end + 1)}.`;
        } else msg += ' Hoy ya no quedan horas baratas: mira el precio de mañana.';
      } else {
        let end = hour;
        while (prices.find(([h, , n]) => h === end + 1 && n === 'barata')) end++;
        msg += ` Seguirá barata hasta las ${hh(end + 1)}.`;
      }
      document.getElementById('now-next')!.textContent = msg;
      document.querySelectorAll(`.bar[data-hour="${hour}"]`).forEach((b) => b.classList.add('now'));
      document.querySelectorAll(`tr[data-hour="${hour}"]`).forEach((r) => r.classList.add('current'));
    }
  }
</script>

<style>
  .hero { background: var(--wash); border-bottom: 1px solid var(--line); padding: 36px 0 28px; }
  .top { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 32px; align-items: end; margin-bottom: 40px; }
  .kicker { margin: 0 0 6px; color: var(--muted); font-weight: 600; }
  h1 { margin: 0; font-size: clamp(2rem, 5vw, 3.3rem); }
  .note { margin: 16px 0 0; color: var(--muted); }
  .now { margin-top: 22px; }
  .now p { margin: 0; }
  .now-state { font-size: 1.05rem; }
  .now-state strong { font-weight: 750; }
  .now.barata .now-state strong { color: var(--barata); }
  .now.media .now-state strong { color: #a76a08; }
  .now.cara .now-state strong { color: var(--cara); }
  .now-price { font-size: clamp(3rem, 9vw, 5rem); font-weight: 800; font-stretch: 125%; letter-spacing: -0.04em; line-height: 1; margin: 6px 0 8px !important; }
  .now-price .unit { font-size: 1.1rem; font-weight: 600; letter-spacing: 0; color: var(--muted); }
  .now-next { color: var(--ink); max-width: 46ch; }
  .facts { margin: 0; display: grid; gap: 10px; }
  .fact { background: var(--paper); border-radius: var(--r-md); padding: 12px 16px; display: grid; grid-template-columns: 1fr auto; column-gap: 12px; align-items: baseline; border-left: 4px solid var(--line); }
  .fact.barata { border-left-color: var(--barata); }
  .fact.cara { border-left-color: var(--cara); }
  .fact dt { color: var(--muted); font-size: 0.9rem; font-weight: 600; }
  .fact dd { margin: 0; text-align: right; }
  .fact b { font-size: 1.35rem; font-weight: 800; font-stretch: 112%; }
  .fact .sub { grid-column: 1 / -1; text-align: left; color: var(--muted); font-size: 0.85rem; }
  @media (max-width: 760px) { .top { grid-template-columns: 1fr; gap: 20px; margin-bottom: 36px; } .hero { padding-top: 24px; } }
</style>
