---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import { madridDate, addDays, getDay } from '../lib/prices.js';

const todayIso = madridDate();
const pack = (d) => (d ? { iso: d.iso, p: d.hours.map((h) => [h.hour, h.price]) } : null);
const initial = [pack(getDay(todayIso)), pack(getDay(addDays(todayIso, 1)))].filter(Boolean);

// Consumos orientativos por uso (kWh) y duración típica (horas)
const aparatos = [
  { id: 'lavadora', n: 'Lavadora (40 °C)', kwh: 0.9, h: 2 },
  { id: 'lavavajillas', n: 'Lavavajillas (programa eco)', kwh: 1.0, h: 3 },
  { id: 'secadora', n: 'Secadora', kwh: 2.5, h: 2 },
  { id: 'horno', n: 'Horno (1 hora)', kwh: 1.2, h: 1 },
  { id: 'vitro', n: 'Vitrocerámica o inducción (1 hora)', kwh: 1.3, h: 1 },
  { id: 'aire', n: 'Aire acondicionado o bomba de calor (1 hora)', kwh: 1.0, h: 1 },
  { id: 'termo', n: 'Termo eléctrico (1 hora)', kwh: 1.5, h: 1 },
  { id: 'plancha', n: 'Plancha (1 hora)', kwh: 1.0, h: 1 },
  { id: 'coche', n: 'Coche eléctrico (carga de 3 h a 7,4 kW)', kwh: 22, h: 3 },
];
const faqs = [
  ['¿Cuánto cuesta poner una lavadora?', 'Un lavado a 40 °C consume alrededor de 0,9 kWh. Con el PVPC, eso suele costar entre unos pocos céntimos en las horas más baratas y más de 30 céntimos en las más caras. La calculadora te dice el coste exacto con los precios de hoy.'],
  ['¿De dónde salen los consumos?', 'Son valores orientativos para aparatos domésticos habituales. Puedes cambiar los kWh y las horas por los de tu aparato: los encontrarás en su etiqueta energética o en el manual.'],
  ['¿El coste incluye impuestos?', 'No. Usamos el precio del término de energía del PVPC publicado por Red Eléctrica, sin IVA ni impuesto eléctrico. Sirve para comparar horas entre sí.'],
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Calculadora de coste de electrodomésticos', applicationCategory: 'UtilitiesApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base
  title="¿Cuánto cuesta poner la lavadora ahora? Calculadora de coste por hora | kWhoy"
  description="Calcula cuánto cuesta poner la lavadora, el lavavajillas, el horno o cargar el coche eléctrico ahora mismo y a qué hora te sale más barato, con el precio de la luz PVPC de hoy."
  jsonLd={jsonLd}
>
  <h1>¿Cuánto cuesta poner la lavadora ahora?</h1>
  <p class="lead">Elige el aparato y te decimos cuánto cuesta usarlo ahora con el precio de la luz de hoy, a qué hora es más barato y cuánto ahorras.</p>

  <form class="card calc" id="calc" onsubmit="return false">
    <label>Aparato
      <select id="ap">
        {aparatos.map((a) => <option value={a.id} data-kwh={a.kwh} data-h={a.h}>{a.n}</option>)}
      </select>
    </label>
    <div class="row">
      <label>Consumo por uso (kWh)<input id="kwh" type="number" step="0.1" min="0.1" inputmode="decimal" /></label>
      <label>Duración (horas)<input id="dur" type="number" step="1" min="1" max="12" inputmode="numeric" /></label>
    </div>
  </form>

  <div class="grid-stats" id="res" aria-live="polite">
    <div class="stat now"><div class="k">Si empiezas ahora</div><div class="v" id="r-now">—</div><div class="s" id="r-now-s"></div></div>
    <div class="stat barata"><div class="k">Hora más barata para empezar</div><div class="v" id="r-best">—</div><div class="s" id="r-best-s"></div></div>
    <div class="stat"><div class="k">Ahorro</div><div class="v" id="r-save">—</div><div class="s" id="r-save-s"></div></div>
  </div>
  <p class="muted" id="r-note">Precios PVPC sin impuestos. Se tienen en cuenta las horas que quedan de hoy y, si ya están publicadas, las de mañana.</p>

  <AdSlot slot={import.meta.env.PUBLIC_AD_SLOT_CALC} />

  <section class="prose">
    <h2>Cómo funciona la calculadora</h2>
    <p>Multiplicamos el consumo del aparato por el precio de la luz de cada hora en la que estará funcionando. Después buscamos el momento de inicio con el que el total sale más barato entre las horas que quedan de hoy y, cuando Red Eléctrica ya los ha publicado (a partir de las 20:15), las de mañana.</p>
    <p>Para ver el precio de cada hora, consulta el <a href="/">precio de la luz hoy</a> y el <a href="/precio-luz-manana/">precio de mañana</a>.</p>
    <h2>Preguntas frecuentes</h2>
    {faqs.map(([q, a]) => (<details><summary>{q}</summary><p>{a}</p></details>))}
  </section>
</Base>

<script is:inline define:vars={{ initial }}>
  (function () {
    var days = initial;
    var $ = function (id) { return document.getElementById(id); };
    var eur = function (v) { return v.toLocaleString('es-ES', { style: 'currency', currency: 'EUR', minimumFractionDigits: v < 1 ? 3 : 2 }); };
    var hh = function (h) { return String(h % 24).padStart(2, '0') + ':00'; };

    function madridNow() {
      var f = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Madrid', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', hour12: false });
      var p = {}; f.formatToParts(new Date()).forEach(function (x) { p[x.type] = x.value; });
      return { iso: p.year + '-' + p.month + '-' + p.day, hour: Number(p.hour) % 24 };
    }
    // Serie de horas desde ahora: [{iso, hour, price}]
    function series() {
      var now = madridNow(), out = [], started = false;
      days.forEach(function (d) {
        d.p.forEach(function (x) {
          if (d.iso > now.iso || (d.iso === now.iso && x[0] >= now.hour)) out.push({ iso: d.iso, hour: x[0], price: x[1], today: d.iso === now.iso });
        });
      });
      return out;
    }
    function calc() {
      var kwh = parseFloat(String($('kwh').value).replace(',', '.')), dur = Math.max(1, Math.round(Number($('dur').value)));
      var s = series();
      if (!(kwh > 0) || s.length < dur) { $('r-now').textContent = '—'; $('r-note').textContent = 'No hay suficientes precios publicados para calcularlo ahora mismo.'; return; }
      var cost = function (i) { var t = 0; for (var k = 0; k < dur; k++) t += s[i + k].price * kwh / dur; return t; };
      var nowCost = cost(0), best = 0, bestCost = nowCost;
      for (var i = 1; i + dur <= s.length; i++) { var c = cost(i); if (c < bestCost) { bestCost = c; best = i; } }
      $('r-now').textContent = eur(nowCost);
      $('r-now-s').textContent = 'de ' + hh(s[0].hour) + ' a ' + hh(s[0].hour + dur);
      $('r-best').textContent = eur(bestCost);
      $('r-best-s').textContent = 'empezando ' + (s[best].today ? 'hoy' : 'mañana') + ' a las ' + hh(s[best].hour);
      var save = nowCost - bestCost;
      $('r-save').textContent = eur(Math.max(0, save));
      $('r-save-s').textContent = save > 0.0005 ? Math.round(save / nowCost * 100) + ' % menos que ahora' : 'Ahora es el mejor momento';
    }
    function fill() {
      var o = $('ap').selectedOptions[0];
      $('kwh').value = o.dataset.kwh; $('dur').value = o.dataset.h; calc();
    }
    $('ap').addEventListener('change', fill);
    $('kwh').addEventListener('input', calc);
    $('dur').addEventListener('input', calc);
    fill();

    // Refresca con datos en directo de Red Eléctrica (por si la página es de ayer)
    var now = madridNow(), d = new Date(now.iso + 'T12:00:00Z'); d.setUTCDate(d.getUTCDate() + 1);
    var end = d.toISOString().slice(0, 10);
    fetch('https://apidatos.ree.es/es/datos/mercados/precios-mercados-tiempo-real?start_date=' + now.iso + 'T00:00&end_date=' + end + 'T23:59&time_trunc=hour')
      .then(function (r) { return r.json(); })
      .then(function (j) {
        var pv = j.included.find(function (x) { return x.type === 'PVPC'; }); if (!pv) return;
        var map = {};
        pv.attributes.values.forEach(function (v) { var iso = v.datetime.slice(0, 10); (map[iso] = map[iso] || []).push([Number(v.datetime.slice(11, 13)), v.value / 1000]); });
        var fresh = Object.keys(map).sort().map(function (iso) { return { iso: iso, p: map[iso] }; });
        if (fresh.length) { days = fresh; calc(); }
      })
      .catch(function () {});
  })();
</script>

<style>
  .calc { display: grid; gap: 12px; margin: 16px 0; }
  .calc label { display: grid; gap: 4px; font-weight: 600; font-size: 0.95rem; }
  .calc .row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .calc select, .calc input { font: inherit; padding: 10px 12px; border: 1px solid var(--line); border-radius: 10px; background: #fff; }
</style>
