---
import Base from '../../layouts/Base.astro';
const guias = [
  ['/guias/precio-kwh-luz/', '¿Cuánto cuesta el kWh de luz hoy?', 'Precio actual con y sin impuestos y media de cada mes.'],
  ['/guias/horarios-punta-llano-valle/', 'Horarios punta, llano y valle', 'Cuándo empieza cada periodo y cuánto cuesta el kWh en cada uno.'],
  ['/guias/como-se-calcula-precio-luz-pvpc/', 'Cómo se calcula el precio PVPC', 'Mercado diario, futuros, peajes y cargos, explicado sin jerga.'],
  ['/guias/cuanto-gasta-aire-acondicionado/', 'Cuánto gasta el aire acondicionado', 'Coste por hora y al mes según las frigorías, en frío y en calor.'],
  ['/guias/cuanto-gasta-calefaccion-electrica/', 'Cuánto gasta la calefacción eléctrica', 'Radiador, calefactor, emisor o bomba de calor: cuál sale más barato.'],
  ['/guias/cuanto-gasta-termo-electrico/', 'Cuánto gasta un termo eléctrico', 'Coste del agua caliente por persona y cómo programarlo.'],
  ['/guias/cuanto-gasta-secadora/', 'Cuánto gasta una secadora', 'Bomba de calor contra condensación, por ciclo y al mes.'],
  ['/guias/cuanto-gasta-horno-electrico/', 'Cuánto gasta un horno eléctrico', 'Y cuándo compensa el microondas o la freidora de aire.'],
  ['/guias/cuanto-gasta-vitroceramica-induccion/', 'Inducción o vitrocerámica', 'Cuánto cuesta cocinar y hervir agua con cada una.'],
  ['/guias/cuanto-gasta-frigorifico/', 'Cuánto gasta un frigorífico', 'Al día, al mes y al año, y cuándo compensa cambiarlo.'],
  ['/guias/mejores-horas-poner-lavadora/', 'Las mejores horas para poner la lavadora', 'Con los precios reales del último mes, hora a hora, laborables y fines de semana.'],
  ['/guias/como-leer-factura-luz/', 'Cómo leer la factura de la luz', 'Cada concepto explicado, con un ejemplo calculado con los precios actuales.'],
  ['/guias/pvpc-o-mercado-libre/', 'PVPC o mercado libre', 'Diferencias, cuándo conviene cada uno y qué mirar en una oferta.'],
  ['/guias/bajar-potencia-contratada/', 'Cómo bajar la potencia contratada', 'Cuánto ahorras, cuánto cuesta el cambio y cada cuánto puedes hacerlo.'],
  ['/guias/bono-social-electrico/', 'Bono social eléctrico 2026', 'Descuentos vigentes, requisitos y pasos para pedirlo.'],
];
---
<Base title="Guías para ahorrar en la factura de la luz | kWhoy" description="Guías prácticas sobre la luz con precios actualizados cada día: cuánto gasta cada electrodoméstico, horarios punta y valle, cómo se calcula el PVPC, potencia contratada y bono social.">
  <h1>Guías para ahorrar en la luz</h1>
  <p class="lead">Explicaciones claras, con datos actuales y fuentes oficiales.</p>
  <div class="tools">
    {guias.map(([href, t, d]) => (<a class="card tool" href={href}><strong>{t}</strong><span>{d}</span></a>))}
  </div>
</Base>
<style>
  .tools { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; margin: 16px 0; }
  .tool { display: grid; gap: 6px; text-decoration: none; color: var(--text); }
  .tool:hover { border-color: var(--navy); }
  .tool span { color: var(--muted); font-size: 0.95rem; }
</style>
